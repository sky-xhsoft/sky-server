# Sky-Server 环境变量
# 复制为 .env（或 configs/.env）后填写真实值；.env 不提交。
# 后端启动时读取 .env，替换 config.yaml 中写成 ${变量名} 或 ${变量名:-默认值} 的配置项。
# 只对文字型配置生效（端口等数字配置直接写在 config.yaml 里）；config.yaml 中没有引用的变量不会生效。
# 已在系统环境中设置的变量优先于 .env。

# 数据库（database.mysql）
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=skyserver

# JWT 签名密钥（jwt.secret）
JWT_SECRET=your-jwt-secret

# 敏感字段加密主密钥（security.fieldEncryptKey）；上线后不要更换，丢失后已加密数据无法解密
FIELD_ENCRYPT_KEY=your-field-encrypt-key

# 平台腾讯云账号（tencentCloud）；各公司的直播与存储密钥在「公司配置」中填写
TENCENT_SECRET_ID=your-tencent-secret-id
TENCENT_SECRET_KEY=your-tencent-secret-key

# 邮件（email）
EMAIL_SMTP_HOST=smtp.exmail.qq.com
EMAIL_USERNAME=your-email-username
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=your-email-from

# 阿里云短信（sms）
SMS_ACCESS_KEY_ID=your-sms-access-key-id
SMS_ACCESS_SECRET=your-sms-access-secret
SMS_SIGN_NAME=your-sms-sign-name
SMS_TEMPLATE_CODE=your-sms-template-code
