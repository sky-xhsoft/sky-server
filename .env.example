# Sky-Server Environment Variables
# Copy to .env and fill in real values

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_password_here
DB_NAME=skyserver

# JWT
JWT_SECRET=your_secure_jwt_secret_here_change_in_production

# Tencent Cloud
TENCENT_SECRET_ID=your_tencent_secret_id
TENCENT_SECRET_KEY=your_tencent_secret_key

# Email
EMAIL_SMTP_HOST=smtp.exmail.qq.com
EMAIL_SMTP_PORT=465
EMAIL_USERNAME=your@email.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=your@email.com

# Aliyun SMS (fill real values in .env, keep this file placeholder-only)
SMS_SIGN_NAME=your_sms_sign_name
SMS_TEMPLATE_CODE=your_sms_template_code
SMS_ACCESS_KEY_ID=your_access_key_id
SMS_ACCESS_SECRET=your_access_secret
